---
import fs from 'node:fs';
import path from 'node:path';

const PORTFOLIO_DIR = path.join(process.cwd(), 'public/photos/portfolio');
const IMAGE_EXT = new Set(['.jpg', '.jpeg', '.png', '.webp']);
const VIDEO_EXT = new Set(['.mp4', '.webm']);

const media = fs.readdirSync(PORTFOLIO_DIR)
  .filter(name => {
    const ext = path.extname(name).toLowerCase();
    return IMAGE_EXT.has(ext) || VIDEO_EXT.has(ext);
  })
  .sort()
  .map(name => ({
    type: VIDEO_EXT.has(path.extname(name).toLowerCase()) ? 'video' : 'image',
    src: `/linktree-site/photos/portfolio/${name}`,
  }));

const TILE_W = 300;
const TILE_H = 400;
const STEP_X = 330;
const STEP_Y = 320;
const PAD = 80;

// Diamond pattern: tiles sit on the perimeter only — one at each cardinal
// point (north / east / south / west) with the middle left open. Edge tiles
// advance in whole grid steps out from each corner, which guarantees
// neighbours are always a full step apart and can never overlap.
function diamondPositions(n) {
  if (n <= 0) return [];

  const cardinals = [
    { gx: 0, gy: -1 }, { gx: 1, gy: 0 }, { gx: 0, gy: 1 }, { gx: -1, gy: 0 },
  ];
  if (n <= 4) return cardinals.slice(0, n);

  const radius = Math.ceil(n / 4);
  const corners = [
    { gx: 0, gy: -radius }, // N
    { gx: radius, gy: 0 },  // E
    { gx: 0, gy: radius },  // S
    { gx: -radius, gy: 0 }, // W
  ];
  const dirs = [
    { dx: 1, dy: 1 }, { dx: -1, dy: 1 }, { dx: -1, dy: -1 }, { dx: 1, dy: -1 },
  ];

  // Spread the non-corner tiles evenly around the four edges.
  const perEdge = [0, 0, 0, 0];
  let remaining = n - 4;
  let e = 0;
  while (remaining > 0 && perEdge.some(c => c < radius - 1)) {
    if (perEdge[e] < radius - 1) { perEdge[e]++; remaining--; }
    e = (e + 1) % 4;
  }

  const out = [];
  for (let i = 0; i < 4; i++) {
    out.push(corners[i]);
    for (let s = 1; s <= perEdge[i]; s++) {
      out.push({
        gx: corners[i].gx + dirs[i].dx * s,
        gy: corners[i].gy + dirs[i].dy * s,
      });
    }
  }
  return out;
}

const slots = diamondPositions(media.length);
const radius = Math.max(1, ...slots.map(s => Math.max(Math.abs(s.gx), Math.abs(s.gy))));

const canvasW = radius * 2 * STEP_X + TILE_W + PAD * 2;
const canvasH = radius * 2 * STEP_Y + TILE_H + PAD * 2;

const placed = media.map((item, i) => ({
  ...item,
  x: PAD + (slots[i].gx + radius) * STEP_X,
  y: PAD + (slots[i].gy + radius) * STEP_Y,
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Dan — Hair Portfolio</title>
  </head>
  <body>
    <header class="topbar">
      <a href="/linktree-site/" class="back">← Back</a>
      <div class="subtitle">Hair Portfolio</div>
      <a href="https://www.vagaro.com/mcgreevysbarbershop/services" target="_blank" rel="noopener" class="book-mini">Book</a>
    </header>

    <div class="viewport" id="viewport">
      <div class="canvas" id="canvas" style={`width:${canvasW}px;height:${canvasH}px`}>
        {placed.map(item => (
          <figure class="tile" data-src={item.src} style={`left:${item.x}px;top:${item.y}px`}>
            {item.type === 'video' ? (
              <video class="media" src={item.src} muted loop playsinline preload="metadata"></video>
            ) : (
              <img class="media" src={item.src} alt="" decoding="async" draggable="false" />
            )}
          </figure>
        ))}
      </div>
    </div>

    <div class="hint" id="hint">Drag to explore · Double-tap a photo to move in</div>

    <script>
      const viewport = document.getElementById('viewport');
      const canvas = document.getElementById('canvas');
      const hint = document.getElementById('hint');
      const tiles = Array.from(document.querySelectorAll('.tile'));

      const MIN_SCALE = 0.18;
      const MAX_SCALE = 3.5;
      const MAX_BLUR = 7;
      // Below this zoom every clip is a thumbnail, so decoding them is wasted
      // work — the single biggest source of pan/zoom jank with this many videos.
      const PLAYBACK_MIN_SCALE = 0.42;

      let scale = 1;
      let tx = 0;
      let ty = 0;
      let animating = false;
      let finishCurrent = null;

      const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));

      // All transform writes funnel through one rAF-batched commit so a burst of
      // pointermove events (high-refresh mice fire several per frame) can never
      // trigger more than one style recalc per frame.
      let frameQueued = false;
      let pendingBlur = 0;

      function commit() {
        frameQueued = false;
        canvas.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
        canvas.style.filter = pendingBlur > 0.05 ? `blur(${pendingBlur}px)` : '';
      }

      function apply(blur) {
        pendingBlur = blur || 0;
        if (frameQueued) return;
        frameQueued = true;
        requestAnimationFrame(commit);
      }

      function applyNow(blur) {
        pendingBlur = blur || 0;
        commit();
      }

      function fitToViewport() {
        const vw = viewport.clientWidth;
        const vh = viewport.clientHeight;
        const cw = canvas.offsetWidth;
        const ch = canvas.offsetHeight;
        scale = clamp(Math.min(vw / cw, vh / ch) * 0.94, MIN_SCALE, MAX_SCALE);
        tx = (vw - cw * scale) / 2;
        ty = (vh - ch * scale) / 2;
        applyNow(0);
        syncPlayback();
      }

      function easeInOutCubic(p) {
        return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
      }

      // The dolly: position eases on a cubic curve while blur rises and falls on
      // a sine arc, peaking at maximum travel speed. Blur scales with distance
      // covered, so short hops stay crisp and long pushes smear.
      function glideTo(nextScale, nextTx, nextTy, duration) {
        if (animating) return;
        animating = true;

        const fromScale = scale, fromTx = tx, fromTy = ty;
        const dScale = nextScale - fromScale;
        const dTx = nextTx - fromTx;
        const dTy = nextTy - fromTy;

        const travel = Math.hypot(dTx, dTy) + Math.abs(dScale) * 400;
        const blurPeak = clamp(travel / 300, 0, MAX_BLUR);

        const start = performance.now();
        canvas.style.willChange = 'transform, filter';

        // Browsers suspend rAF in background tabs. Without this escape hatch a
        // move interrupted by a tab switch would leave `animating` stuck true
        // and kill every later zoom.
        finishCurrent = () => {
          finishCurrent = null;
          scale = nextScale; tx = nextTx; ty = nextTy;
          applyNow(0);
          canvas.style.willChange = '';
          animating = false;
          syncPlayback();
        };

        function frame(now) {
          if (!animating) return;
          const p = clamp((now - start) / duration, 0, 1);
          const eased = easeInOutCubic(p);

          scale = fromScale + dScale * eased;
          tx = fromTx + dTx * eased;
          ty = fromTy + dTy * eased;
          applyNow(Math.sin(p * Math.PI) * blurPeak);

          if (p < 1) {
            requestAnimationFrame(frame);
          } else {
            finishCurrent = null;
            canvas.style.willChange = '';
            animating = false;
            syncPlayback();
          }
        }
        requestAnimationFrame(frame);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden && finishCurrent) finishCurrent();
      });

      function scaleToFill(tile) {
        const vw = viewport.clientWidth;
        const vh = viewport.clientHeight;
        return clamp(
          Math.min(vw / tile.offsetWidth, vh / tile.offsetHeight) * 0.86,
          MIN_SCALE,
          MAX_SCALE
        );
      }

      function pushInto(tile) {
        const vw = viewport.clientWidth;
        const vh = viewport.clientHeight;
        const target = scaleToFill(tile);

        // Already framed on this tile — pull back to the whole board so the
        // gesture toggles instead of dead-ending.
        if (Math.abs(scale - target) < 0.05) {
          const cw = canvas.offsetWidth, ch = canvas.offsetHeight;
          const out = clamp(Math.min(vw / cw, vh / ch) * 0.94, MIN_SCALE, MAX_SCALE);
          glideTo(out, (vw - cw * out) / 2, (vh - ch * out) / 2, 780);
          return;
        }

        const cx = tile.offsetLeft + tile.offsetWidth / 2;
        const cy = tile.offsetTop + tile.offsetHeight / 2;
        glideTo(target, vw / 2 - cx * target, vh / 2 - cy * target, 780);
      }

      // Pointer capture during a drag retargets mouse events to the viewport, so
      // a dblclick bound to a tile never reaches it. Delegate instead.
      viewport.addEventListener('dblclick', (e) => {
        const tile = e.target.closest('.tile');
        if (!tile) return;
        e.preventDefault();
        pushInto(tile);
      });

      // Images and videos are the browser's favourite drag targets. Killing the
      // native drag is what stops a pan turning into "grabbed a photo".
      viewport.addEventListener('dragstart', (e) => e.preventDefault());

      // --- Drag to pan -------------------------------------------------------
      let dragging = false;
      let moved = false;
      let lastX = 0, lastY = 0;
      const activePointers = new Map();
      let pinchStart = null;

      viewport.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (activePointers.size === 1) {
          dragging = true;
          moved = false;
          lastX = e.clientX;
          lastY = e.clientY;
          viewport.setPointerCapture(e.pointerId);
          viewport.classList.add('grabbing');
        }
      });

      viewport.addEventListener('pointermove', (e) => {
        if (!activePointers.has(e.pointerId)) return;
        activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

        if (activePointers.size === 2) { handlePinch(); return; }
        if (!dragging || animating) return;

        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        if (Math.abs(dx) > 2 || Math.abs(dy) > 2) moved = true;
        tx += dx;
        ty += dy;
        lastX = e.clientX;
        lastY = e.clientY;
        apply(0);
        dismissHint();
      });

      function endPointer(e) {
        activePointers.delete(e.pointerId);
        if (activePointers.size < 2) pinchStart = null;
        if (activePointers.size === 0) {
          dragging = false;
          viewport.classList.remove('grabbing');
          syncPlayback();
        }
      }
      viewport.addEventListener('pointerup', endPointer);
      viewport.addEventListener('pointercancel', endPointer);

      // --- Pinch -------------------------------------------------------------
      function handlePinch() {
        if (animating) return;
        const pts = Array.from(activePointers.values());
        const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        const midX = (pts[0].x + pts[1].x) / 2;
        const midY = (pts[0].y + pts[1].y) / 2;

        if (!pinchStart) { pinchStart = { dist, scale }; return; }

        zoomAround(midX, midY, clamp(pinchStart.scale * (dist / pinchStart.dist), MIN_SCALE, MAX_SCALE));
        dismissHint();
      }

      // Keep the point under the fingers/cursor pinned while scale changes.
      function zoomAround(originX, originY, nextScale) {
        const rect = viewport.getBoundingClientRect();
        const px = originX - rect.left;
        const py = originY - rect.top;
        const k = nextScale / scale;
        tx = px - (px - tx) * k;
        ty = py - (py - ty) * k;
        scale = nextScale;
        apply(0);
      }

      // --- Wheel / trackpad --------------------------------------------------
      let wheelSettle = null;
      viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        if (animating) return;
        zoomAround(e.clientX, e.clientY, clamp(scale * Math.exp(-e.deltaY * 0.0022), MIN_SCALE, MAX_SCALE));
        dismissHint();
        clearTimeout(wheelSettle);
        wheelSettle = setTimeout(syncPlayback, 140);
      }, { passive: false });

      // --- Double-tap (touch) ------------------------------------------------
      let lastTapAt = 0, lastTapX = 0, lastTapY = 0;
      viewport.addEventListener('pointerup', (e) => {
        if (e.pointerType === 'mouse' || moved) return;
        const now = performance.now();
        const near = Math.hypot(e.clientX - lastTapX, e.clientY - lastTapY) < 30;
        if (now - lastTapAt < 320 && near) {
          const el = document.elementFromPoint(e.clientX, e.clientY);
          const tile = el && el.closest('.tile');
          if (tile) pushInto(tile);
          lastTapAt = 0;
        } else {
          lastTapAt = now;
          lastTapX = e.clientX;
          lastTapY = e.clientY;
        }
      });

      // --- Hint --------------------------------------------------------------
      let hintGone = false;
      function dismissHint() {
        if (hintGone) return;
        hintGone = true;
        hint.classList.add('gone');
      }
      setTimeout(dismissHint, 6000);

      // --- Playback budget ---------------------------------------------------
      // Only clips that are both on screen and large enough to be worth watching
      // are allowed to decode. Everything else holds a still frame.
      const videoTiles = tiles.filter(t => t.querySelector('video'));
      const onScreen = new Set();

      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        syncPlayback();
      }, { root: viewport, rootMargin: '120px' });

      videoTiles.forEach(t => io.observe(t));

      let syncQueued = false;
      function syncPlayback() {
        if (syncQueued) return;
        syncQueued = true;
        requestAnimationFrame(() => {
          syncQueued = false;
          const allowed = scale >= PLAYBACK_MIN_SCALE;
          for (const tile of videoTiles) {
            const video = tile.querySelector('video');
            const shouldPlay = allowed && onScreen.has(tile);
            if (shouldPlay && video.paused) {
              const p = video.play();
              if (p && p.catch) p.catch(() => {});
            } else if (!shouldPlay && !video.paused) {
              video.pause();
            }
          }
        });
      }

      // --- Init --------------------------------------------------------------
      if (document.readyState === 'complete') fitToViewport();
      else window.addEventListener('load', fitToViewport);
      window.addEventListener('resize', fitToViewport);
    </script>
  </body>
</html>

<style>
  :global(html), :global(body) {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #141413;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    overscroll-behavior: none;
  }

  .topbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: linear-gradient(180deg, rgba(20,20,19,0.92) 0%, rgba(20,20,19,0) 100%);
    pointer-events: none;
  }
  .topbar a { pointer-events: auto; }

  .back { font-size: 13px; color: #a09d96; text-decoration: none; }
  .back:hover { color: #faf9f5; }

  .subtitle {
    font-size: 11px;
    color: #a09d96;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .book-mini {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #e8a55a;
    text-decoration: none;
    border: 1px solid rgba(232,165,90,0.55);
    border-radius: 9999px;
    padding: 6px 14px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .book-mini:hover { border-color: #e8a55a; background: rgba(232,165,90,0.12); }

  .viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    background: radial-gradient(ellipse at 50% 40%, #201f1c 0%, #141413 72%);
  }
  .viewport.grabbing { cursor: grabbing; }

  .canvas {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    /* Promoted to its own layer up front so panning never re-rasterises. */
    will-change: transform;
  }

  .tile {
    position: absolute;
    width: 300px;
    height: 400px;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #1f1e1b;
    box-shadow: 0 20px 44px rgba(0,0,0,0.5);
  }

  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Media never receives pointer events, so a click-drag can never latch onto
       a photo instead of panning the board. */
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .hint {
    position: fixed;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-size: 11px;
    letter-spacing: 0.8px;
    color: #a09d96;
    background: rgba(20,20,19,0.6);
    border: 1px solid rgba(250,249,245,0.14);
    border-radius: 9999px;
    padding: 8px 16px;
    white-space: nowrap;
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }
  .hint.gone { opacity: 0; transform: translateX(-50%) translateY(8px); }
</style>
