---
import fs from 'node:fs';
import path from 'node:path';

const PORTFOLIO_DIR = path.join(process.cwd(), 'public/photos/portfolio');
const IMAGE_EXT = new Set(['.jpg', '.jpeg', '.png', '.webp']);
const VIDEO_EXT = new Set(['.mp4', '.webm', '.mov']);

const items = fs.readdirSync(PORTFOLIO_DIR)
  .filter(name => IMAGE_EXT.has(path.extname(name).toLowerCase()) || VIDEO_EXT.has(path.extname(name).toLowerCase()))
  .sort()
  .map(name => {
    const ext = path.extname(name).toLowerCase();
    return {
      type: VIDEO_EXT.has(ext) ? 'video' : 'image',
      src: `/linktree-site/photos/portfolio/${name}`,
    };
  });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dan — Hair Portfolio</title>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <a href="/linktree-site/" class="back">← Back</a>
        <div class="header-center">
          <div class="subtitle">Hair Portfolio</div>
        </div>
      </header>

      <div class="grid">
        {items.map((item, i) => (
          item.type === 'video' ? (
            <button class="slot loop-video" style={`--i:${i}`} data-type="video" data-src={item.src} aria-label="Open video">
              <video class="v" muted playsinline preload="auto"></video>
              <video class="v" muted playsinline preload="auto"></video>
            </button>
          ) : (
            <button class="slot" style={`--i:${i}`} data-type="image" data-src={item.src} aria-label="Open photo">
              <img src={item.src} alt="" />
            </button>
          )
        ))}
      </div>

      <section class="bio-section">
        <div class="bio-avatar"></div>
        <p class="bio-text">
          Booth renter at McGreevey's Barbershop. I specialize in fades, tapers, and textured cuts.
          Walk-ins by appointment only — book through the link below to secure your spot.
        </p>
        <div class="bio-tags">
          <span class="tag">Fades</span>
          <span class="tag">Tapers</span>
          <span class="tag">Textured Cuts</span>
          <span class="tag">Beard Trims</span>
        </div>
      </section>

      <footer class="footer">
        <a href="https://www.vagaro.com/mcgreevysbarbershop/services" target="_blank" rel="noopener" class="book-full">Book an Appointment</a>
      </footer>
    </main>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lb-close" aria-label="Close">✕</button>
      <button class="lb-nav lb-prev" aria-label="Previous">‹</button>
      <button class="lb-nav lb-next" aria-label="Next">›</button>
      <div class="lb-stage">
        <div class="lb-content" id="lbContent"></div>
      </div>
    </div>

    <script define:vars={{ items }}>
      // Seamless loop via dual-buffer crossfade: the visible video is never
      // seeked (that's what caused decode corruption at the loop point on
      // Android/iOS). A hidden twin restarts and takes over instead.
      const SWAP_BEFORE = 0.15;

      function startLoopVideo(container) {
        const src = container.dataset.src;
        const [a, b] = container.querySelectorAll('video');
        a.src = src;
        b.src = src;

        function arm(active, standby) {
          function onTimeUpdate() {
            if (active.duration && active.currentTime >= active.duration - SWAP_BEFORE) {
              active.removeEventListener('timeupdate', onTimeUpdate);
              standby.currentTime = 0;
              standby.play().catch(() => {});
              standby.classList.add('active');
              active.classList.remove('active');
              setTimeout(() => {
                active.pause();
                active.currentTime = 0;
              }, 120);
              arm(standby, active);
            }
          }
          active.addEventListener('timeupdate', onTimeUpdate);
        }

        a.classList.add('active');
        a.play().catch(() => {});
        arm(a, b);
      }

      document.querySelectorAll('.grid .loop-video').forEach(startLoopVideo);

      // Lightbox: tap a grid item to expand full-screen, swipe/arrows to move
      // between items, tap outside or Escape/close to dismiss. `items` is
      // injected at build time from the actual portfolio folder contents —
      // whatever is open-ended, no fixed slot count.
      const slots = Array.from(document.querySelectorAll('.grid .slot'));
      const lightbox = document.getElementById('lightbox');
      const lbContent = document.getElementById('lbContent');
      let currentIndex = 0;
      let isOpen = false;
      let isTransitioning = false;

      // Astro's scoped-CSS attribute only lands on elements written in the
      // static markup, so JS-created nodes miss the stylesheet's sizing
      // rules. Set the critical dimensions inline instead.
      function buildLightboxItem(item) {
        if (item.type === 'video') {
          const container = document.createElement('div');
          container.className = 'loop-video lb-video';
          container.dataset.src = item.src;
          container.style.cssText = 'position:relative;width:min(92vw,80vh);height:min(92vw,80vh);border-radius:10px;overflow:hidden;';
          container.innerHTML = '<video class="v" muted playsinline preload="auto" style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;"></video><video class="v" muted playsinline preload="auto" style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;"></video>';
          startLoopVideo(container);
          return container;
        }
        const img = document.createElement('img');
        img.src = item.src;
        img.alt = '';
        img.style.cssText = 'max-width:92vw;max-height:80vh;width:auto;height:auto;object-fit:contain;border-radius:10px;display:block;';
        return img;
      }

      function renderLightboxItem(index, direction) {
        const node = buildLightboxItem(items[index]);
        node.style.opacity = '0';
        node.style.transform = direction === 'next' ? 'translateX(24px)' : direction === 'prev' ? 'translateX(-24px)' : 'scale(0.97)';
        node.style.transition = 'opacity 0.22s cubic-bezier(0.22,1,0.36,1), transform 0.22s cubic-bezier(0.22,1,0.36,1)';
        lbContent.appendChild(node);
        // Force a layout flush so the transition from the initial inline
        // style above actually animates instead of jumping straight to rest.
        void node.offsetWidth;
        node.style.opacity = '1';
        node.style.transform = 'translateX(0) scale(1)';
      }

      function clearLightboxContent() {
        lbContent.innerHTML = '';
      }

      function goTo(index, direction) {
        if (isTransitioning) return;
        isTransitioning = true;
        const outgoing = lbContent.firstElementChild;
        if (outgoing) {
          outgoing.style.transition = 'opacity 0.16s ease, transform 0.16s ease';
          outgoing.style.opacity = '0';
          outgoing.style.transform = direction === 'next' ? 'translateX(-24px)' : direction === 'prev' ? 'translateX(24px)' : 'scale(0.97)';
        }
        setTimeout(() => {
          clearLightboxContent();
          currentIndex = index;
          renderLightboxItem(currentIndex, direction);
          isTransitioning = false;
        }, outgoing ? 140 : 0);
      }

      function openLightbox(index) {
        currentIndex = index;
        clearLightboxContent();
        renderLightboxItem(currentIndex, null);
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        isOpen = true;
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        isOpen = false;
        setTimeout(clearLightboxContent, 280);
      }

      function showNext() {
        goTo((currentIndex + 1) % items.length, 'next');
      }

      function showPrev() {
        goTo((currentIndex - 1 + items.length) % items.length, 'prev');
      }

      slots.forEach((slot, index) => {
        slot.addEventListener('click', () => openLightbox(index));
      });

      document.querySelector('.lb-close').addEventListener('click', closeLightbox);
      document.querySelector('.lb-next').addEventListener('click', showNext);
      document.querySelector('.lb-prev').addEventListener('click', showPrev);

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox || e.target.classList.contains('lb-stage')) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (!isOpen) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') showNext();
        if (e.key === 'ArrowLeft') showPrev();
      });

      let touchStartX = 0;
      lbContent.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
      });
      lbContent.addEventListener('touchend', (e) => {
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        if (deltaX > 50) showPrev();
        else if (deltaX < -50) showNext();
      });
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #181715;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
  }

  .page {
    max-width: 480px;
    margin: 0 auto;
    padding-bottom: 40px;
    box-sizing: border-box;
  }

  @media (min-width: 860px) {
    .page { max-width: 900px; }
    .grid { grid-template-columns: repeat(6, 1fr); }
    .book-full { max-width: 420px; }
  }

  /* Header */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #252320;
  }

  .back {
    font-size: 13px;
    color: #a09d96;
    text-decoration: none;
    min-width: 48px;
  }

  .back:hover { color: #faf9f5; }

  .header-center {
    flex: 1;
    text-align: center;
  }

  .subtitle {
    font-size: 11px;
    color: #a09d96;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 2px;
    background: #1f1e1b;
  }

  .slot {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #1f1e1b;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: block;
  }

  .slot img,
  .slot video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .loop-video .v {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .loop-video .v.active {
    opacity: 1;
  }

  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.88); }
    to   { opacity: 1; transform: scale(1); }
  }
  .slot {
    animation: pop-in 0.45s ease forwards;
    animation-delay: calc(var(--i) * 70ms);
  }

  /* Biography */
  .bio-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 36px 24px 28px;
    background: #252320;
    text-align: center;
  }

  .bio-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #1f1e1b;
    border: 2px solid #e8a55a;
    margin-bottom: 14px;
  }

  .bio-text {
    font-size: 14px;
    line-height: 1.65;
    color: #a09d96;
    max-width: 380px;
    margin: 14px 0 20px;
  }

  .bio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .tag {
    padding: 4px 12px;
    background: transparent;
    color: #faf9f5;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    border-radius: 9999px;
    border: 1px solid #e8a55a;
  }

  /* Footer */
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 20px 0;
  }

  .book-full {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    background: #e8a55a;
    color: #141413;
    font-size: 14px;
    font-weight: 700;
    border-radius: 9999px;
    border: 2px solid #141413;
    text-decoration: none;
    box-sizing: border-box;
    box-shadow: 5px 5px 0 0 #141413;
    transition: transform 0.1s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.1s cubic-bezier(0.34,1.56,0.64,1);
  }
  .book-full:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 0 #141413;
  }
  .book-full:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 0 #141413;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(10,10,9,0.96);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.28s cubic-bezier(0.22,1,0.36,1), visibility 0s linear 0.28s;
  }
  .lightbox.open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.28s cubic-bezier(0.22,1,0.36,1), visibility 0s linear 0s;
  }

  .lb-stage {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
  }

  .lb-close,
  .lb-nav {
    position: absolute;
    z-index: 101;
    background: rgba(20,20,19,0.55);
    color: #faf9f5;
    border: 1px solid rgba(250,249,245,0.25);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .lb-close:hover,
  .lb-nav:hover {
    border-color: rgba(232,165,90,0.9);
    transform: scale(1.06);
  }

  .lb-close {
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    font-size: 16px;
  }

  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 26px;
  }
  .lb-nav:hover { transform: translateY(-50%) scale(1.06); }
  .lb-prev { left: 12px; }
  .lb-next { right: 12px; }

  @media (min-width: 860px) {
    .lb-close { top: 24px; right: 24px; }
    .lb-prev { left: 24px; }
    .lb-next { right: 24px; }
  }
</style>
