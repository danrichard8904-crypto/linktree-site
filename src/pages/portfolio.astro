---
import fs from 'node:fs';
import path from 'node:path';

const PORTFOLIO_DIR = path.join(process.cwd(), 'public/photos/portfolio');
const IMAGE_EXT = new Set(['.jpg', '.jpeg', '.png', '.webp']);
const VIDEO_EXT = new Set(['.mp4', '.webm', '.mov']);

const items = fs.readdirSync(PORTFOLIO_DIR)
  .filter(name => {
    const ext = path.extname(name).toLowerCase();
    return IMAGE_EXT.has(ext) || VIDEO_EXT.has(ext);
  })
  .sort()
  .map(name => ({
    type: VIDEO_EXT.has(path.extname(name).toLowerCase()) ? 'video' : 'image',
    src: `/linktree-site/photos/portfolio/${name}`,
  }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Dan — Hair Portfolio</title>
  </head>
  <body>
    <header class="topbar">
      <a href="/linktree-site/" class="back">← Back</a>
      <div class="subtitle">Hair Portfolio</div>
      <a href="https://www.vagaro.com/mcgreevysbarbershop/services" target="_blank" rel="noopener" class="book-mini">Book</a>
    </header>

    <div class="viewport" id="viewport">
      <div class="canvas" id="canvas">
        {items.map((item, i) => (
          <figure class="tile" data-index={i} data-type={item.type} data-src={item.src}>
            {item.type === 'video' ? (
              <div class="loop-video" data-src={item.src}>
                <video class="v" muted playsinline preload="auto"></video>
                <video class="v" muted playsinline preload="auto"></video>
              </div>
            ) : (
              <img src={item.src} alt="" draggable="false" />
            )}
          </figure>
        ))}
      </div>
    </div>

    <div class="hint" id="hint">Drag to explore · Double-tap a photo to move in</div>

    <script>
      const viewport = document.getElementById('viewport');
      const canvas = document.getElementById('canvas');
      const hint = document.getElementById('hint');
      const tiles = Array.from(document.querySelectorAll('.tile'));

      const MIN_SCALE = 0.25;
      const MAX_SCALE = 4;
      const MAX_BLUR = 7;

      let scale = 1;
      let tx = 0;
      let ty = 0;
      let animating = false;

      function clamp(v, lo, hi) { return Math.min(hi, Math.max(lo, v)); }

      function apply(blur) {
        canvas.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
        canvas.style.filter = blur > 0.05 ? `blur(${blur}px)` : '';
      }

      // Fit the whole board in view on first paint so the full collection reads
      // at a glance, the way the zoomed-out state does in the reference.
      function fitToViewport() {
        const vw = viewport.clientWidth;
        const vh = viewport.clientHeight;
        const cw = canvas.offsetWidth;
        const ch = canvas.offsetHeight;
        scale = clamp(Math.min(vw / cw, vh / ch) * 0.92, MIN_SCALE, MAX_SCALE);
        tx = (vw - cw * scale) / 2;
        ty = (vh - ch * scale) / 2;
        apply(0);
      }

      function easeInOutCubic(p) {
        return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
      }

      // The dolly move: position eases along a cubic curve while blur rises and
      // falls on a sine arc, peaking at maximum travel speed. Blur magnitude is
      // proportional to distance covered, so small nudges stay crisp and long
      // pushes smear — the "camera on a cart" feel rather than a hard cut.
      function glideTo(nextScale, nextTx, nextTy, duration) {
        if (animating) return;
        animating = true;

        const fromScale = scale, fromTx = tx, fromTy = ty;
        const dScale = nextScale - fromScale;
        const dTx = nextTx - fromTx;
        const dTy = nextTy - fromTy;

        const travel = Math.hypot(dTx, dTy) + Math.abs(dScale) * 400;
        const blurPeak = clamp(travel / 260, 0, MAX_BLUR);

        const start = performance.now();
        canvas.style.willChange = 'transform, filter';

        function frame(now) {
          const p = clamp((now - start) / duration, 0, 1);
          const eased = easeInOutCubic(p);

          scale = fromScale + dScale * eased;
          tx = fromTx + dTx * eased;
          ty = fromTy + dTy * eased;

          apply(Math.sin(p * Math.PI) * blurPeak);

          if (p < 1) {
            requestAnimationFrame(frame);
          } else {
            canvas.style.willChange = '';
            animating = false;
          }
        }
        requestAnimationFrame(frame);
      }

      // Compute the transform that centers a given tile at a given scale.
      function framingFor(tile, targetScale) {
        const vw = viewport.clientWidth;
        const vh = viewport.clientHeight;
        // Tile offsets are in unscaled canvas space.
        const cx = tile.offsetLeft + tile.offsetWidth / 2;
        const cy = tile.offsetTop + tile.offsetHeight / 2;
        return {
          tx: vw / 2 - cx * targetScale,
          ty: vh / 2 - cy * targetScale,
        };
      }

      function scaleToFill(tile) {
        const vw = viewport.clientWidth;
        const vh = viewport.clientHeight;
        const pad = 0.86;
        return clamp(
          Math.min(vw / tile.offsetWidth, vh / tile.offsetHeight) * pad,
          MIN_SCALE,
          MAX_SCALE
        );
      }

      function pushInto(tile) {
        const target = scaleToFill(tile);
        // Already framed on this tile? Pull back out to the full board instead,
        // so double-tap toggles rather than dead-ends.
        if (Math.abs(scale - target) < 0.05) {
          const vw = viewport.clientWidth, vh = viewport.clientHeight;
          const cw = canvas.offsetWidth, ch = canvas.offsetHeight;
          const outScale = clamp(Math.min(vw / cw, vh / ch) * 0.92, MIN_SCALE, MAX_SCALE);
          glideTo(outScale, (vw - cw * outScale) / 2, (vh - ch * outScale) / 2, 760);
          return;
        }
        const f = framingFor(tile, target);
        glideTo(target, f.tx, f.ty, 760);
      }

      // Pointer capture taken during a drag retargets mouse events to the
      // viewport, so a dblclick bound to a tile never reaches it. Delegate from
      // the viewport and resolve the tile from the event target instead.
      viewport.addEventListener('dblclick', (e) => {
        const tile = e.target.closest('.tile');
        if (!tile) return;
        e.preventDefault();
        pushInto(tile);
      });

      // Touch devices do not reliably emit dblclick, so detect the double-tap.
      let lastTapAt = 0;
      let lastTapX = 0;
      let lastTapY = 0;
      viewport.addEventListener('pointerup', (e) => {
        if (e.pointerType === 'mouse' || moved) return;
        const now = performance.now();
        const near = Math.hypot(e.clientX - lastTapX, e.clientY - lastTapY) < 30;
        if (now - lastTapAt < 320 && near) {
          const el = document.elementFromPoint(e.clientX, e.clientY);
          const tile = el && el.closest('.tile');
          if (tile) pushInto(tile);
          lastTapAt = 0;
        } else {
          lastTapAt = now;
          lastTapX = e.clientX;
          lastTapY = e.clientY;
        }
      });

      // --- Drag to pan -------------------------------------------------------
      let dragging = false;
      let moved = false;
      let lastX = 0, lastY = 0;
      let activePointers = new Map();

      viewport.addEventListener('pointerdown', (e) => {
        activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (activePointers.size === 1) {
          dragging = true;
          moved = false;
          lastX = e.clientX;
          lastY = e.clientY;
          viewport.setPointerCapture(e.pointerId);
          viewport.classList.add('grabbing');
        }
      });

      viewport.addEventListener('pointermove', (e) => {
        if (!activePointers.has(e.pointerId)) return;
        activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

        if (activePointers.size === 2) {
          handlePinch();
          return;
        }
        if (!dragging || animating) return;

        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        if (Math.abs(dx) > 2 || Math.abs(dy) > 2) moved = true;
        tx += dx;
        ty += dy;
        lastX = e.clientX;
        lastY = e.clientY;
        apply(0);
        dismissHint();
      });

      function endPointer(e) {
        activePointers.delete(e.pointerId);
        if (activePointers.size < 2) pinchStart = null;
        if (activePointers.size === 0) {
          dragging = false;
          viewport.classList.remove('grabbing');
        }
      }
      viewport.addEventListener('pointerup', endPointer);
      viewport.addEventListener('pointercancel', endPointer);

      // --- Pinch to zoom -----------------------------------------------------
      let pinchStart = null;

      function handlePinch() {
        if (animating) return;
        const pts = Array.from(activePointers.values());
        const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        const midX = (pts[0].x + pts[1].x) / 2;
        const midY = (pts[0].y + pts[1].y) / 2;

        if (!pinchStart) {
          pinchStart = { dist, scale, midX, midY };
          return;
        }

        const nextScale = clamp(pinchStart.scale * (dist / pinchStart.dist), MIN_SCALE, MAX_SCALE);
        zoomAround(midX, midY, nextScale);
        dismissHint();
      }

      // Keep the point under the fingers/cursor pinned while scale changes.
      function zoomAround(originX, originY, nextScale) {
        const rect = viewport.getBoundingClientRect();
        const px = originX - rect.left;
        const py = originY - rect.top;
        const k = nextScale / scale;
        tx = px - (px - tx) * k;
        ty = py - (py - ty) * k;
        scale = nextScale;
        apply(0);
      }

      // --- Wheel / trackpad zoom --------------------------------------------
      viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        if (animating) return;
        const factor = Math.exp(-e.deltaY * 0.0022);
        const nextScale = clamp(scale * factor, MIN_SCALE, MAX_SCALE);
        zoomAround(e.clientX, e.clientY, nextScale);
        dismissHint();
      }, { passive: false });

      // --- Hint --------------------------------------------------------------
      let hintGone = false;
      function dismissHint() {
        if (hintGone) return;
        hintGone = true;
        hint.classList.add('gone');
      }
      setTimeout(dismissHint, 6000);

      // --- Video loops -------------------------------------------------------
      // Dual-buffer crossfade: the visible video is never seeked (seeking is what
      // caused decode corruption at the loop point). A hidden twin restarts and
      // takes over. Opacity is set inline because Astro's scoped-CSS attribute
      // is not guaranteed on every path that touches these nodes.
      const SWAP_BEFORE = 0.15;

      function startLoopVideo(container) {
        const src = container.dataset.src;
        const [a, b] = container.querySelectorAll('video');
        a.src = src;
        b.src = src;

        function setActive(video, active) {
          video.classList.toggle('active', active);
          video.style.opacity = active ? '1' : '0';
        }

        // play() called right after setting .src rejects while the element still
        // has no data. Retry once the browser reports it can actually play.
        function tryPlay(video) {
          const p = video.play();
          if (p && p.catch) {
            p.catch(() => {
              video.addEventListener('canplay', () => {
                video.play().catch(() => {});
              }, { once: true });
            });
          }
        }

        function arm(active, standby) {
          function onTimeUpdate() {
            if (active.duration && active.currentTime >= active.duration - SWAP_BEFORE) {
              active.removeEventListener('timeupdate', onTimeUpdate);
              standby.currentTime = 0;
              tryPlay(standby);
              setActive(standby, true);
              setActive(active, false);
              setTimeout(() => {
                active.pause();
                active.currentTime = 0;
              }, 120);
              arm(standby, active);
            }
          }
          active.addEventListener('timeupdate', onTimeUpdate);
        }

        setActive(a, true);
        tryPlay(a);
        arm(a, b);
      }

      document.querySelectorAll('.loop-video').forEach(startLoopVideo);

      // --- Init --------------------------------------------------------------
      function init() { fitToViewport(); }

      if (document.readyState === 'complete') init();
      else window.addEventListener('load', init);
      window.addEventListener('resize', fitToViewport);
    </script>
  </body>
</html>

<style>
  :global(html), :global(body) {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #141413;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    overscroll-behavior: none;
  }

  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: linear-gradient(180deg, rgba(20,20,19,0.9) 0%, rgba(20,20,19,0) 100%);
    pointer-events: none;
  }
  .topbar a { pointer-events: auto; }

  .back {
    font-size: 13px;
    color: #a09d96;
    text-decoration: none;
  }
  .back:hover { color: #faf9f5; }

  .subtitle {
    font-size: 11px;
    color: #a09d96;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .book-mini {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #e8a55a;
    text-decoration: none;
    border: 1px solid rgba(232,165,90,0.55);
    border-radius: 9999px;
    padding: 6px 14px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .book-mini:hover {
    border-color: #e8a55a;
    background: rgba(232,165,90,0.12);
  }

  .viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    background:
      radial-gradient(ellipse at 50% 40%, #1f1e1b 0%, #141413 70%);
  }
  .viewport.grabbing { cursor: grabbing; }

  .canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 1100px;
    transform-origin: 0 0;
    column-count: 3;
    column-gap: 18px;
    padding: 18px;
    box-sizing: border-box;
  }

  .tile {
    break-inside: avoid;
    margin: 0 0 18px;
    border-radius: 14px;
    overflow: hidden;
    background: #1f1e1b;
    box-shadow: 0 18px 40px rgba(0,0,0,0.45);
    position: relative;
    line-height: 0;
  }

  .tile img,
  .tile video {
    width: 100%;
    height: auto;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .loop-video {
    position: relative;
    width: 100%;
    /* Portrait clips: reserve height so masonry does not jump before metadata. */
    aspect-ratio: 9 / 16;
  }
  .loop-video .v {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .loop-video .v.active { opacity: 1; }

  .hint {
    position: fixed;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-size: 11px;
    letter-spacing: 0.8px;
    color: #a09d96;
    background: rgba(20,20,19,0.6);
    border: 1px solid rgba(250,249,245,0.14);
    border-radius: 9999px;
    padding: 8px 16px;
    white-space: nowrap;
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }
  .hint.gone {
    opacity: 0;
    transform: translateX(-50%) translateY(8px);
  }

  @media (min-width: 860px) {
    .canvas { column-count: 4; width: 1500px; }
  }
</style>
