---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dan — Hair Portfolio</title>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <a href="/linktree-site/" class="back">← Back</a>
        <div class="header-center">
          <div class="name">Dan</div>
          <div class="subtitle">Hair Portfolio</div>
        </div>
        <a href="https://www.vagaro.com/mcgreevysbarbershop/services" target="_blank" rel="noopener" class="book-btn">Book</a>
      </header>

      <div class="grid">
        <div class="slot" style="--i:0"><img src="/linktree-site/photos/IMG_4542.jpg" alt="" /></div>
        <div class="slot" style="--i:1"><img src="/linktree-site/photos/IMG_4950.jpg" alt="" /></div>
        <div class="slot loop-video" style="--i:2" data-src="/linktree-site/photos/IMG_5008.mp4">
          <video class="v" muted playsinline preload="auto"></video>
          <video class="v" muted playsinline preload="auto"></video>
        </div>
        <div class="slot loop-video" style="--i:3" data-src="/linktree-site/photos/IMG_4355.mp4">
          <video class="v" muted playsinline preload="auto"></video>
          <video class="v" muted playsinline preload="auto"></video>
        </div>
        <div class="slot loop-video" style="--i:4" data-src="/linktree-site/photos/IMG_4998.mp4">
          <video class="v" muted playsinline preload="auto"></video>
          <video class="v" muted playsinline preload="auto"></video>
        </div>
        <div class="slot loop-video" style="--i:5" data-src="/linktree-site/photos/IMG_5030.mp4">
          <video class="v" muted playsinline preload="auto"></video>
          <video class="v" muted playsinline preload="auto"></video>
        </div>
      </div>

      <section class="bio-section">
        <div class="bio-avatar"></div>
        <h2 class="bio-name">Dan</h2>
        <p class="bio-handle">@Reppstory</p>
        <p class="bio-text">
          Booth renter at McGreevey's Barbershop. I specialize in fades, tapers, and textured cuts.
          Walk-ins by appointment only — book through the link below to secure your spot.
        </p>
        <div class="bio-tags">
          <span class="tag">Fades</span>
          <span class="tag">Tapers</span>
          <span class="tag">Textured Cuts</span>
          <span class="tag">Beard Trims</span>
        </div>
      </section>

      <footer class="footer">
        <a href="https://www.vagaro.com/mcgreevysbarbershop/services" target="_blank" rel="noopener" class="book-full">Book an Appointment</a>
        <a href="https://www.instagram.com/Reppstory/" target="_blank" rel="noopener" class="insta">@Reppstory on Instagram</a>
      </footer>
    </main>

    <script>
      // Seamless loop via dual-buffer crossfade: the visible video is never
      // seeked (that's what caused the decode corruption at the loop point).
      // A hidden twin restarts and takes over instead.
      const SWAP_BEFORE = 0.15;

      document.querySelectorAll('.loop-video').forEach(container => {
        const src = container.dataset.src;
        const [a, b] = container.querySelectorAll('video');
        a.src = src;
        b.src = src;

        function arm(active, standby) {
          function onTimeUpdate() {
            if (active.duration && active.currentTime >= active.duration - SWAP_BEFORE) {
              active.removeEventListener('timeupdate', onTimeUpdate);
              standby.currentTime = 0;
              standby.play().catch(() => {});
              standby.classList.add('active');
              active.classList.remove('active');
              setTimeout(() => {
                active.pause();
                active.currentTime = 0;
              }, 120);
              arm(standby, active);
            }
          }
          active.addEventListener('timeupdate', onTimeUpdate);
        }

        a.classList.add('active');
        a.play().catch(() => {});
        arm(a, b);
      });
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #faf9f5;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
  }

  .page {
    max-width: 480px;
    margin: 0 auto;
    padding-bottom: 40px;
    box-sizing: border-box;
  }

  @media (min-width: 860px) {
    .page { max-width: 900px; }
    .grid { grid-template-columns: repeat(6, 1fr); }
    .book-full { max-width: 420px; }
  }

  /* Header */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #e6dfd8;
  }

  .back {
    font-size: 13px;
    color: #8e8b82;
    text-decoration: none;
    min-width: 48px;
  }

  .back:hover { color: #141413; }

  .header-center {
    text-align: center;
  }

  .name {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 17px;
    font-weight: 400;
    color: #141413;
    letter-spacing: -0.2px;
  }

  .subtitle {
    font-size: 11px;
    color: #8e8b82;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .book-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    height: 32px;
    padding: 0 12px;
    background: #141413;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    letter-spacing: 0.3px;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 2px;
  }

  .slot {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #efe9de;
  }

  .slot img,
  .slot video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .loop-video .v {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .loop-video .v.active {
    opacity: 1;
  }

  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.88); }
    to   { opacity: 1; transform: scale(1); }
  }
  .slot {
    animation: pop-in 0.45s ease forwards;
    animation-delay: calc(var(--i) * 70ms);
  }

  /* Biography */
  .bio-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 36px 24px 28px;
    border-bottom: 1px solid #e6dfd8;
    text-align: center;
  }

  .bio-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #efe9de;
    border: 1px solid #e6dfd8;
    margin-bottom: 14px;
  }

  .bio-name {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 22px;
    font-weight: 400;
    color: #141413;
    margin: 0;
    letter-spacing: -0.2px;
  }

  .bio-handle {
    font-size: 13px;
    color: #8e8b82;
    margin: 4px 0 16px;
  }

  .bio-text {
    font-size: 14px;
    line-height: 1.65;
    color: #3d3d3a;
    max-width: 380px;
    margin: 0 0 20px;
  }

  .bio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .tag {
    padding: 4px 12px;
    background: #efe9de;
    color: #141413;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    border-radius: 9999px;
    border: 1px solid #e6dfd8;
  }

  /* Footer */
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 20px 0;
  }

  .book-full {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 46px;
    background: #141413;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    box-sizing: border-box;
  }

  .insta {
    font-size: 13px;
    color: #8e8b82;
    text-decoration: none;
  }

  .insta:hover { color: #141413; }
</style>
