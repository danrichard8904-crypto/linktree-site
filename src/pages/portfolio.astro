---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dan — Hair Portfolio</title>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <a href="/linktree-site/" class="back">← Back</a>
        <div class="header-center">
          <div class="subtitle">Hair Portfolio</div>
        </div>
      </header>

      <div class="grid">
        <button class="slot" style="--i:0" data-type="image" data-src="/linktree-site/photos/IMG_4542.jpg" aria-label="Open photo">
          <img src="/linktree-site/photos/IMG_4542.jpg" alt="" />
        </button>
        <button class="slot" style="--i:1" data-type="image" data-src="/linktree-site/photos/IMG_4950.jpg" aria-label="Open photo">
          <img src="/linktree-site/photos/IMG_4950.jpg" alt="" />
        </button>
        <button class="slot loop-video" style="--i:2" data-type="video" data-src="/linktree-site/photos/IMG_5008.mp4" aria-label="Open video">
          <video class="v" muted playsinline preload="auto"></video>
          <video class="v" muted playsinline preload="auto"></video>
        </button>
        <button class="slot loop-video" style="--i:3" data-type="video" data-src="/linktree-site/photos/IMG_4355.mp4" aria-label="Open video">
          <video class="v" muted playsinline preload="auto"></video>
          <video class="v" muted playsinline preload="auto"></video>
        </button>
        <button class="slot" style="--i:4" data-type="image" data-src="/linktree-site/photos/IMG_4966.jpg" aria-label="Open photo">
          <img src="/linktree-site/photos/IMG_4966.jpg" alt="" />
        </button>
        <button class="slot loop-video" style="--i:5" data-type="video" data-src="/linktree-site/photos/IMG_5030.mp4" aria-label="Open video">
          <video class="v" muted playsinline preload="auto"></video>
          <video class="v" muted playsinline preload="auto"></video>
        </button>
      </div>

      <section class="bio-section">
        <div class="bio-avatar"></div>
        <p class="bio-text">
          Booth renter at McGreevey's Barbershop. I specialize in fades, tapers, and textured cuts.
          Walk-ins by appointment only — book through the link below to secure your spot.
        </p>
        <div class="bio-tags">
          <span class="tag">Fades</span>
          <span class="tag">Tapers</span>
          <span class="tag">Textured Cuts</span>
          <span class="tag">Beard Trims</span>
        </div>
      </section>

      <footer class="footer">
        <a href="https://www.vagaro.com/mcgreevysbarbershop/services" target="_blank" rel="noopener" class="book-full">Book an Appointment</a>
      </footer>
    </main>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lb-close" aria-label="Close">✕</button>
      <button class="lb-nav lb-prev" aria-label="Previous">‹</button>
      <button class="lb-nav lb-next" aria-label="Next">›</button>
      <div class="lb-content" id="lbContent"></div>
    </div>

    <script>
      // Seamless loop via dual-buffer crossfade: the visible video is never
      // seeked (that's what caused the decode corruption at the loop point).
      // A hidden twin restarts and takes over instead.
      const SWAP_BEFORE = 0.15;

      function startLoopVideo(container) {
        const src = container.dataset.src;
        const [a, b] = container.querySelectorAll('video');
        a.src = src;
        b.src = src;

        function arm(active, standby) {
          function onTimeUpdate() {
            if (active.duration && active.currentTime >= active.duration - SWAP_BEFORE) {
              active.removeEventListener('timeupdate', onTimeUpdate);
              standby.currentTime = 0;
              standby.play().catch(() => {});
              standby.classList.add('active');
              active.classList.remove('active');
              setTimeout(() => {
                active.pause();
                active.currentTime = 0;
              }, 120);
              arm(standby, active);
            }
          }
          active.addEventListener('timeupdate', onTimeUpdate);
        }

        a.classList.add('active');
        a.play().catch(() => {});
        arm(a, b);
      }

      document.querySelectorAll('.grid .loop-video').forEach(startLoopVideo);

      // Lightbox: tap a grid item to expand full-screen, swipe/arrows to move
      // between items, tap outside or Escape/close to dismiss.
      const slots = Array.from(document.querySelectorAll('.grid .slot'));
      const items = slots.map(slot => ({
        type: slot.dataset.type,
        src: slot.dataset.src,
      }));

      const lightbox = document.getElementById('lightbox');
      const lbContent = document.getElementById('lbContent');
      let currentIndex = 0;
      let isOpen = false;

      function renderLightboxItem(index) {
        lbContent.innerHTML = '';
        const item = items[index];
        if (item.type === 'video') {
          const container = document.createElement('div');
          container.className = 'loop-video lb-video';
          container.dataset.src = item.src;
          container.innerHTML = '<video class="v" muted playsinline preload="auto"></video><video class="v" muted playsinline preload="auto"></video>';
          lbContent.appendChild(container);
          startLoopVideo(container);
        } else {
          const img = document.createElement('img');
          img.src = item.src;
          img.alt = '';
          lbContent.appendChild(img);
        }
      }

      function openLightbox(index) {
        currentIndex = index;
        renderLightboxItem(currentIndex);
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        isOpen = true;
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        lbContent.innerHTML = '';
        isOpen = false;
      }

      function showNext() {
        currentIndex = (currentIndex + 1) % items.length;
        renderLightboxItem(currentIndex);
      }

      function showPrev() {
        currentIndex = (currentIndex - 1 + items.length) % items.length;
        renderLightboxItem(currentIndex);
      }

      slots.forEach((slot, index) => {
        slot.addEventListener('click', () => openLightbox(index));
      });

      document.querySelector('.lb-close').addEventListener('click', closeLightbox);
      document.querySelector('.lb-next').addEventListener('click', showNext);
      document.querySelector('.lb-prev').addEventListener('click', showPrev);

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (!isOpen) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') showNext();
        if (e.key === 'ArrowLeft') showPrev();
      });

      let touchStartX = 0;
      lbContent.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
      });
      lbContent.addEventListener('touchend', (e) => {
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        if (deltaX > 50) showPrev();
        else if (deltaX < -50) showNext();
      });
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #181715;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
  }

  .page {
    max-width: 480px;
    margin: 0 auto;
    padding-bottom: 40px;
    box-sizing: border-box;
  }

  @media (min-width: 860px) {
    .page { max-width: 900px; }
    .grid { grid-template-columns: repeat(6, 1fr); }
    .book-full { max-width: 420px; }
  }

  /* Header */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #252320;
  }

  .back {
    font-size: 13px;
    color: #a09d96;
    text-decoration: none;
    min-width: 48px;
  }

  .back:hover { color: #faf9f5; }

  .header-center {
    flex: 1;
    text-align: center;
  }

  .subtitle {
    font-size: 11px;
    color: #a09d96;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 2px;
    background: #1f1e1b;
  }

  .slot {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #1f1e1b;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: block;
  }

  .slot img,
  .slot video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .loop-video .v {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .loop-video .v.active {
    opacity: 1;
  }

  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.88); }
    to   { opacity: 1; transform: scale(1); }
  }
  .slot {
    animation: pop-in 0.45s ease forwards;
    animation-delay: calc(var(--i) * 70ms);
  }

  /* Biography */
  .bio-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 36px 24px 28px;
    background: #252320;
    text-align: center;
  }

  .bio-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #1f1e1b;
    border: 2px solid #e8a55a;
    margin-bottom: 14px;
  }

  .bio-text {
    font-size: 14px;
    line-height: 1.65;
    color: #a09d96;
    max-width: 380px;
    margin: 14px 0 20px;
  }

  .bio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .tag {
    padding: 4px 12px;
    background: transparent;
    color: #faf9f5;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    border-radius: 9999px;
    border: 1px solid #e8a55a;
  }

  /* Footer */
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 20px 0;
  }

  .book-full {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    background: #e8a55a;
    color: #141413;
    font-size: 14px;
    font-weight: 700;
    border-radius: 9999px;
    border: 2px solid #141413;
    text-decoration: none;
    box-sizing: border-box;
    box-shadow: 5px 5px 0 0 #141413;
    transition: transform 0.1s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.1s cubic-bezier(0.34,1.56,0.64,1);
  }
  .book-full:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 0 #141413;
  }
  .book-full:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 0 #141413;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(10,10,9,0.96);
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .lightbox.open {
    display: flex;
    opacity: 1;
  }

  .lb-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
  }
  .lb-content img,
  .lb-content .lb-video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
  }
  .lb-content .lb-video {
    position: relative;
    aspect-ratio: 1;
    max-height: 100%;
  }
  .lb-content .lb-video .v {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
  }
  .lb-content .lb-video .v.active {
    opacity: 1;
  }

  .lb-close,
  .lb-nav {
    position: absolute;
    z-index: 101;
    background: rgba(20,20,19,0.55);
    color: #faf9f5;
    border: 1px solid rgba(250,249,245,0.25);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .lb-close:hover,
  .lb-nav:hover {
    border-color: rgba(232,165,90,0.9);
  }

  .lb-close {
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    font-size: 16px;
  }

  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 26px;
  }
  .lb-prev { left: 12px; }
  .lb-next { right: 12px; }

  @media (min-width: 860px) {
    .lb-close { top: 24px; right: 24px; }
    .lb-prev { left: 24px; }
    .lb-next { right: 24px; }
  }
</style>
