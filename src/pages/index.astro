---
// Base path comes from astro.config.mjs, which differs per host
// (Cloudflare serves at root, github.io at /linktree-site).
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dan — Barber / Stylist</title>
  </head>
  <body>
    <div class="layout">
      <main class="card">
        <div class="bg-photo" aria-hidden="true">
          <img src={`${base}photos/dan-outdoor.jpg`} alt="" width="941" height="1672" fetchpriority="high" decoding="async">
        </div>
        <div class="bg-scrim"></div>
        <div class="content">
          <h1 class="title anim" style="--d:0">My Work</h1>

          <div class="link-row anim" style="--d:1">
            <a href={`${base}portfolio`} class="text-link">Hair Portfolio</a>
            <a href={`${base}ai-projects`} class="text-link">AI Projects</a>
          </div>

          <div class="icon-row anim" style="--d:2">
            <a href="https://www.instagram.com/Reppstory/" class="social-icon" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4.2"/>
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
            <a href="https://www.tiktok.com/@d287806" class="social-icon" aria-label="TikTok">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M14 3c.4 2.2 2 3.8 4.2 4.1v2.6c-1.5-.1-2.9-.6-4.1-1.4v6.4c0 3-2.4 5.3-5.3 5.3S3.5 17.7 3.5 14.8 5.9 9.5 8.8 9.5c.4 0 .8 0 1.2.1v2.7c-.4-.1-.8-.2-1.2-.2-1.5 0-2.7 1.2-2.7 2.7s1.2 2.7 2.7 2.7 2.8-1.2 2.8-2.7V3h2.4z"/>
              </svg>
            </a>
            <a href="https://github.com/danrichard8904-crypto" target="_blank" rel="noopener" class="social-icon" aria-label="GitHub">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.4.6.1.82-.26.82-.58 0-.28-.01-1.02-.02-2-3.34.72-4.04-1.6-4.04-1.6-.55-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.93.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.21.69.82.57C20.56 21.8 24 17.3 24 12 24 5.37 18.63 0 12 0z"/>
              </svg>
            </a>
          </div>

          <footer class="footer anim" style="--d:3">© 2026 Reppstory</footer>
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #141413;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .layout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
  }
  .card {
    position: relative;
    width: 100%;
    max-width: 420px;
    min-height: 100vh;
    box-sizing: border-box;
    overflow: hidden;
    background: #141413;
  }

  .bg-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .bg-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .bg-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(20,20,19,0.55) 0%,
      rgba(20,20,19,0.15) 28%,
      rgba(20,20,19,0.25) 55%,
      rgba(20,20,19,0.75) 100%);
    z-index: 1;
  }

  .content {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 21vh 28px 32px;
    box-sizing: border-box;
  }

  .title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #faf9f5;
    margin: 0 0 30px;
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  .link-row {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 26px;
    font-size: 14px;
    font-weight: 400;
  }
  .text-link {
    color: #faf9f5;
    text-transform: lowercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: rgba(250,249,245,0.85);
    opacity: 0.95;
  }

  .icon-row {
    display: flex;
    align-items: center;
    gap: 26px;
    color: #faf9f5;
  }
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #faf9f5;
    text-decoration: none;
    opacity: 0.95;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .social-icon:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .footer {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    color: rgba(250,249,245,0.2);
    font-size: 11px;
    text-align: center;
  }

  @media (min-width: 860px) {
    .layout {
      max-width: none;
      margin: 0;
      gap: 0;
      padding: 0;
      min-height: 100vh;
    }
    .card {
      min-height: 100vh;
      height: 100vh;
      width: 100%;
      max-width: none;
      flex: 1;
      border-radius: 0;
    }
    .bg-photo img { object-position: center 38%; }
    .content {
      min-height: 100vh;
      justify-content: center;
      padding: 64px 40px;
    }
    .title {
      font-size: clamp(28px, 4vw, 44px);
    }
    .link-row {
      font-size: 21px;
      gap: 36px;
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .anim {
    opacity: 0;
    animation: rise 0.5s ease forwards;
    animation-delay: calc(var(--d) * 100ms);
  }
</style>
