---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dan — Barber / Stylist</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
    <link rel="prefetch" href="/linktree-site/photos/dan-cutout.png" as="image">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4355.mp4" as="video">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4998.mp4" as="video">
    <link rel="prefetch" href="/linktree-site/photos/IMG_5030.mp4" as="video">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4542.jpg" as="image">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4950.jpg" as="image">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4966.jpg" as="image">
  </head>
  <body>
    <div class="layout">
      <main class="card">
        <div class="poster">
          <div class="poster-cap poster-cap-left">
            <span class="cap-label">Barber / Stylist</span>
            <span class="cap-sub">Booth renter · appt only</span>
          </div>
          <div class="poster-cap poster-cap-right">
            <span class="cap-label">@Reppstory</span>
          </div>
          <h1 class="wordmark">DAN</h1>
          <img class="cutout" src="/linktree-site/photos/dan-cutout.png" alt="Dan" />
          <a href="/linktree-site/portfolio" class="poster-cta">HAIR<br/>PORTFOLIO</a>
          <div class="poster-links">
            <a href="https://www.instagram.com/Reppstory/" target="_blank" rel="noopener">Instagram</a>
            <a href="#">TikTok</a>
          </div>
        </div>
      </main>
      <aside class="preview" aria-hidden="true">
        <a href="/linktree-site/portfolio" class="preview-grid" tabindex="-1">
          <img src="/linktree-site/photos/IMG_4542.jpg" alt="" />
          <img src="/linktree-site/photos/IMG_4950.jpg" alt="" />
          <img src="/linktree-site/photos/IMG_4966.jpg" alt="" />
          <video src="/linktree-site/photos/IMG_4355.mp4" autoplay muted loop playsinline preload="auto"></video>
        </a>
        <p class="preview-label">Recent Work</p>
      </aside>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #ffffff;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .layout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
  }
  .card {
    position: relative;
    width: 100%;
    max-width: 420px;
    min-height: 100vh;
    box-sizing: border-box;
    overflow: hidden;
    background: #ffffff;
  }

  .poster {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100vh;
  }

  .wordmark {
    position: absolute;
    top: 7%;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-family: 'Anton', Impact, 'Arial Narrow', sans-serif;
    font-weight: 400;
    font-size: clamp(84px, 26vw, 130px);
    line-height: 0.85;
    letter-spacing: -2px;
    color: #f0401c;
    z-index: 1;
  }

  .cutout {
    position: relative;
    z-index: 2;
    display: block;
    margin: 20% auto 0;
    width: 76%;
    max-width: 320px;
    height: auto;
    pointer-events: none;
  }

  .poster-cap {
    position: absolute;
    z-index: 3;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.4;
    color: #141413;
  }
  .poster-cap-left {
    top: 8%;
    left: 6%;
    text-align: left;
  }
  .poster-cap-right {
    top: 8%;
    right: 6%;
    text-align: right;
  }
  .cap-label { display: block; }
  .cap-sub {
    display: block;
    color: #8e8b82;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    margin-top: 2px;
  }

  .poster-cta {
    position: absolute;
    z-index: 3;
    top: 60%;
    left: 8%;
    font-family: 'Anton', Impact, 'Arial Narrow', sans-serif;
    font-weight: 400;
    font-size: clamp(30px, 9vw, 42px);
    line-height: 0.95;
    letter-spacing: -1px;
    color: #f0401c;
    text-decoration: none;
  }

  .poster-links {
    position: absolute;
    z-index: 3;
    bottom: 6%;
    right: 6%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .poster-links a {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #141413;
    text-decoration: none;
    border-bottom: 2px solid #f0401c;
    padding-bottom: 2px;
  }

  .preview { display: none; }

  @media (min-width: 860px) {
    .layout {
      max-width: 1100px;
      margin: 0 auto;
      gap: 64px;
      padding: 0 48px;
      min-height: 100vh;
    }
    .card {
      min-height: unset;
      height: 780px;
      flex: 0 0 380px;
      border-radius: 20px;
      border: 1px solid #ececec;
    }
    .poster { min-height: unset; height: 100%; }
    .preview {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 1;
    }
    .preview-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 6px;
      border-radius: 16px;
      overflow: hidden;
      aspect-ratio: 1;
      max-width: 480px;
      text-decoration: none;
    }
    .preview-grid img,
    .preview-grid video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }
    .preview-label {
      font-size: 12px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #8e8b82;
      margin: 0;
      text-align: center;
    }
  }
</style>
