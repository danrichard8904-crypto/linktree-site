---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dan — Barber / Stylist</title>
    <link rel="prefetch" href="/linktree-site/photos/dan-outdoor.jpg" as="image">
  </head>
  <body>
    <div class="layout">
      <main class="card">
        <div class="bg-photo"></div>
        <div class="bg-scrim"></div>
        <div class="content">
          <h1 class="title anim" style="--d:0">dan</h1>

          <div class="link-row anim" style="--d:1">
            <a href="/linktree-site/portfolio" class="text-link">Hair Portfolio</a>
            <span class="text-link is-disabled" aria-disabled="true">Coming Soon</span>
          </div>

          <div class="icon-row anim" style="--d:2">
            <a href="https://www.instagram.com/Reppstory/" class="social-icon" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4.2"/>
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
            <a href="https://www.tiktok.com/@Reppstory" class="social-icon" aria-label="TikTok">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M14 3c.4 2.2 2 3.8 4.2 4.1v2.6c-1.5-.1-2.9-.6-4.1-1.4v6.4c0 3-2.4 5.3-5.3 5.3S3.5 17.7 3.5 14.8 5.9 9.5 8.8 9.5c.4 0 .8 0 1.2.1v2.7c-.4-.1-.8-.2-1.2-.2-1.5 0-2.7 1.2-2.7 2.7s1.2 2.7 2.7 2.7 2.8-1.2 2.8-2.7V3h2.4z"/>
              </svg>
            </a>
          </div>

          <footer class="footer anim" style="--d:3">© 2026 Reppstory</footer>
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #141413;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .layout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
  }
  .card {
    position: relative;
    width: 100%;
    max-width: 420px;
    min-height: 100vh;
    box-sizing: border-box;
    overflow: hidden;
    background: #141413;
  }

  .bg-photo {
    position: absolute;
    inset: 0;
    background-image: url('/linktree-site/photos/dan-outdoor.jpg');
    background-size: cover;
    background-position: center 20%;
    z-index: 0;
  }
  .bg-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(20,20,19,0.55) 0%,
      rgba(20,20,19,0.15) 28%,
      rgba(20,20,19,0.25) 55%,
      rgba(20,20,19,0.75) 100%);
    z-index: 1;
  }

  .content {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 28px 32px;
    box-sizing: border-box;
  }

  .title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    color: #faf9f5;
    margin: 0 0 30px;
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  .link-row {
    display: flex;
    align-items: baseline;
    gap: 30px;
    margin-bottom: 26px;
    font-size: 19px;
    font-weight: 400;
  }
  .text-link {
    color: #faf9f5;
    text-transform: lowercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: rgba(250,249,245,0.85);
    opacity: 0.95;
  }
  .text-link.is-disabled {
    cursor: default;
    opacity: 0.7;
  }

  .icon-row {
    display: flex;
    align-items: center;
    gap: 26px;
    color: #faf9f5;
  }
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #faf9f5;
    text-decoration: none;
    opacity: 0.95;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .social-icon:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .footer {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    color: rgba(250,249,245,0.2);
    font-size: 11px;
    text-align: center;
  }

  @media (min-width: 860px) {
    .layout {
      max-width: none;
      margin: 0;
      gap: 0;
      padding: 0;
      min-height: 100vh;
    }
    .card {
      min-height: 100vh;
      height: 100vh;
      width: 100%;
      max-width: none;
      flex: 1;
      border-radius: 0;
    }
    .bg-photo { background-position: center 38%; }
    .content {
      min-height: 100vh;
      padding: 64px 40px;
    }
    .title {
      font-size: clamp(28px, 4vw, 44px);
    }
    .link-row {
      font-size: 21px;
      gap: 36px;
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .anim {
    opacity: 0;
    animation: rise 0.5s ease forwards;
    animation-delay: calc(var(--d) * 100ms);
  }
</style>
