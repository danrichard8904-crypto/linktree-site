<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dan — Barber / Stylist</title>
    <link rel="prefetch" href="/linktree-site/photos/IMG_4355.mp4" as="video">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4998.mp4" as="video">
    <link rel="prefetch" href="/linktree-site/photos/IMG_5030.mp4" as="video">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4542.jpg" as="image">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4950.jpg" as="image">
    <link rel="prefetch" href="/linktree-site/photos/IMG_4966.jpg" as="image">
  </head>
  <body>
    <div class="layout">
      <main class="card">
        <div class="avatar anim" style="--d:0"></div>
        <h1 class="name anim" style="--d:1">Dan</h1>
        <span class="badge anim" style="--d:2">Barber / Stylist</span>
        <p class="bio anim" style="--d:3">Booth renter · walk-ins by appointment only</p>
        <nav class="links">
          <a href="/linktree-site/portfolio" class="btn btn-primary anim" style="--d:4">
            <span>Hair Portfolio</span><span class="arr">→</span>
          </a>
          <a href="https://www.instagram.com/Reppstory/" class="btn btn-secondary anim" style="--d:5" target="_blank" rel="noopener">
            <span>Instagram</span><span class="arr">→</span>
          </a>
          <a href="#" class="btn btn-secondary anim" style="--d:6">
            <span>TikTok</span><span class="arr">→</span>
          </a>
        </nav>
      </main>
      <aside class="preview anim" style="--d:3" aria-hidden="true">
        <a href="/linktree-site/portfolio" class="preview-grid" tabindex="-1">
          <img src="/linktree-site/photos/IMG_4542.jpg" alt="" />
          <img src="/linktree-site/photos/IMG_4950.jpg" alt="" />
          <img src="/linktree-site/photos/IMG_4966.jpg" alt="" />
          <video src="/linktree-site/photos/IMG_4355.mp4" autoplay muted playsinline preload="auto"></video>
        </a>
        <p class="preview-label">Recent Work</p>
      </aside>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #faf9f5;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .layout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
  }
  .card {
    width: 100%;
    max-width: 420px;
    min-height: 100vh;
    padding: 48px 28px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }
  .avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: #efe9de;
    border: 1px solid #e6dfd8;
    margin-bottom: 16px;
  }
  .name {
    font-family: Georgia, 'Tiempos Headline', 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 400;
    letter-spacing: -0.3px;
    color: #141413;
    margin: 0;
    text-align: center;
  }
  .badge {
    margin-top: 8px;
    padding: 4px 12px;
    background: #efe9de;
    color: #141413;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 9999px;
  }
  .bio {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.55;
    color: #3d3d3a;
    text-align: center;
  }
  .links {
    width: 100%;
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 56px;
    padding: 0 22px;
    border-radius: 9999px;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2px;
    text-decoration: none;
    box-sizing: border-box;
    /* hard offset shadow = the 3D "raised slab" look */
    transition: transform 0.1s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.1s cubic-bezier(0.34,1.56,0.64,1);
    position: relative;
    cursor: pointer;
  }
  .arr {
    font-size: 17px;
    transition: transform 0.2s ease;
  }
  .btn:hover .arr { transform: translateX(5px); }

  /* Primary — black slab with warm brown 3D shadow */
  .btn-primary {
    background: #141413;
    color: #fff;
    border: 2px solid #141413;
    box-shadow: 5px 5px 0 0 #6b4f3a,
                0 12px 28px rgba(20,20,19,0.22);
  }
  .btn-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 0 #6b4f3a,
                0 16px 32px rgba(20,20,19,0.28);
  }
  .btn-primary:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 0 #6b4f3a,
                0 2px 6px rgba(20,20,19,0.15);
  }

  /* Secondary — cream slab with hard black 3D shadow + outline */
  .btn-secondary {
    background: #faf9f5;
    color: #141413;
    border: 2px solid #141413;
    box-shadow: 5px 5px 0 0 #141413;
  }
  .btn-secondary:hover {
    background: #efe9de;
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 0 #141413;
  }
  .btn-secondary:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 0 #141413;
  }
  .preview { display: none; }

  @media (min-width: 860px) {
    .layout {
      max-width: 1100px;
      margin: 0 auto;
      gap: 64px;
      padding: 0 48px;
      min-height: 100vh;
    }
    .card {
      min-height: unset;
      flex: 0 0 380px;
      padding: 0;
    }
    .preview {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 1;
    }
    .preview-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 6px;
      border-radius: 16px;
      overflow: hidden;
      aspect-ratio: 1;
      max-width: 480px;
      text-decoration: none;
    }
    .preview-grid img,
    .preview-grid video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }
    .preview-label {
      font-size: 12px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #8e8b82;
      margin: 0;
      text-align: center;
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .anim {
    opacity: 0;
    animation: rise 0.5s ease forwards;
    animation-delay: calc(var(--d) * 80ms);
  }
</style>
