---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dan — Barber / Stylist</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap" rel="stylesheet">
    <link rel="prefetch" href="/linktree-site/photos/dan-outdoor.jpg" as="image">
  </head>
  <body>
    <div class="layout">
      <main class="card">
        <div class="bg-photo"></div>
        <div class="bg-scrim"></div>
        <div class="content">
          <h1 class="script-name anim" style="--d:0">Dan</h1>

          <div class="handle-row anim" style="--d:1">
            <div class="divider-row">
              <span class="line"></span>
              <span class="handle">@Reppstory</span>
              <span class="line"></span>
            </div>
            <div class="icon-row">
              <a href="https://www.instagram.com/Reppstory/" class="icon-circle" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="5"/>
                  <circle cx="12" cy="12" r="4.2"/>
                  <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>
                </svg>
              </a>
              <a href="https://www.tiktok.com/@Reppstory" class="icon-circle" aria-label="TikTok">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <path d="M14 3c.4 2.2 2 3.8 4.2 4.1v2.6c-1.5-.1-2.9-.6-4.1-1.4v6.4c0 3-2.4 5.3-5.3 5.3S3.5 17.7 3.5 14.8 5.9 9.5 8.8 9.5c.4 0 .8 0 1.2.1v2.7c-.4-.1-.8-.2-1.2-.2-1.5 0-2.7 1.2-2.7 2.7s1.2 2.7 2.7 2.7 2.8-1.2 2.8-2.7V3h2.4z"/>
                </svg>
              </a>
 
            </div>
          </div>

          <div class="glass-links anim" style="--d:2">
            <a href="/linktree-site/portfolio" class="glass-pill">Hair Portfolio</a>
          </div>

          <footer class="footer anim" style="--d:3">© 2026 Reppstory</footer>
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #141413;
    font-family: Inter, -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .layout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
  }
  .card {
    position: relative;
    width: 100%;
    max-width: 420px;
    min-height: 100vh;
    box-sizing: border-box;
    overflow: hidden;
    background: #141413;
  }

  .bg-photo {
    position: absolute;
    inset: 0;
    background-image: url('/linktree-site/photos/dan-outdoor.jpg');
    background-size: cover;
    background-position: center 20%;
    z-index: 0;
  }
  .bg-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(20,20,19,0.55) 0%,
      rgba(20,20,19,0.15) 28%,
      rgba(20,20,19,0.25) 55%,
      rgba(20,20,19,0.75) 100%);
    z-index: 1;
  }

  .content {
    position: relative;
    z-index: 2;
    height: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 28px 32px;
    box-sizing: border-box;
  }

  .script-name {
    font-family: 'Alex Brush', cursive;
    font-size: 56px;
    color: #faf9f5;
    margin: 0;
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }
  .handle-row {
    margin-top: 14px;
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .glass-links {
    margin-top: 14vh;
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .glass-pill {
    width: 100%;
    height: 54px;
    border-radius: 9999px;
    background: rgba(20,20,19,0.42);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(232,165,90,0.55);
    color: #e8a55a;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .glass-pill:hover {
    border-color: rgba(232,165,90,0.9);
    transform: translateY(-2px);
  }

  .divider-row {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }
  .divider-row .line {
    flex: 1;
    height: 1px;
    background: rgba(250,249,245,0.3);
  }
  .divider-row .handle {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #faf9f5;
    opacity: 0.85;
    white-space: nowrap;
  }

  .icon-row {
    display: flex;
    gap: 14px;
  }
  .icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(20,20,19,0.42);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(250,249,245,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #faf9f5;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .icon-circle:hover {
    border-color: rgba(232,165,90,0.9);
    transform: translateY(-2px);
  }

  .footer {
    margin-top: 16px;
    color: rgba(250,249,245,0.2);
    font-size: 11px;
    text-align: center;
  }

  @media (min-width: 860px) {
    .layout {
      max-width: none;
      margin: 0;
      gap: 0;
      padding: 0;
      min-height: 100vh;
    }
    .card {
      min-height: 100vh;
      height: 100vh;
      width: 100%;
      max-width: none;
      flex: 1;
      border-radius: 0;
    }
    .bg-photo { background-position: center 38%; }
    .content {
      min-height: unset;
      height: 100%;
      padding: 64px 40px;
    }
    .script-name {
      font-size: clamp(56px, 6vw, 104px);
    }
    .handle-row .handle {
      font-size: 13px;
    }
    .glass-pill {
      height: 60px;
      font-size: 15px;
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .anim {
    opacity: 0;
    animation: rise 0.5s ease forwards;
    animation-delay: calc(var(--d) * 100ms);
  }
</style>
